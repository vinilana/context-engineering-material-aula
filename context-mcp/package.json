{
  "name": "pronto-context-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "files": [
    "dist",
    "data/schema.sql",
    "data/seed",
    "invokta.deploy.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --pretty false",
    "typecheck": "tsc -p tsconfig.json --pretty false --noEmit && tsc -p tsconfig.test.json --pretty false --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run check:mcp",
    "check:mcp": "invokta check-mcp ./dist/engine.js",
    "direct": "node dist/direct.js",
    "devtools": "tsc -p tsconfig.json --pretty false && invokta-devtools serve dist/engine.js --watch --build \"tsc -p tsconfig.json --pretty false\"",
    "devtools:doctor": "tsc -p tsconfig.json --pretty false && invokta-devtools doctor dist/engine.js",
    "pretest": "npm run build",
    "mcp:http": "node dist/mcp-http.js",
    "mcp:demo": "INVOKTA_HTTP_HOST=127.0.0.1 INVOKTA_HTTP_PORT=3334 INVOKTA_HTTP_AUTH_MODE=development node dist/mcp-http.js",
    "db:seed": "node dist/seed.js",
    "deploy:package": "invokta-deploy package",
    "deploy:probe": "invokta-deploy probe"
  },
  "dependencies": {
    "@invokta/core": "0.9.0",
    "@invokta/mcp": "0.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@invokta/devtools": "0.9.0",
    "@invokta/tooling": "0.9.0",
    "@types/node": "26.1.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@invokta/deploy": "0.9.0"
  }
}
