# Runtime settings. Environment variables take precedence over .env.
CONTEXT_DB_PATH=./data/context.sqlite
INVOKTA_HTTP_HOST=127.0.0.1
INVOKTA_HTTP_PORT=3334

# Default HTTP mode requires a token. Supply your own value outside version control.
INVOKTA_HTTP_AUTH_MODE=required
CONTEXT_MCP_TOKEN=

# npm run mcp:demo explicitly selects loopback-only development mode instead.
